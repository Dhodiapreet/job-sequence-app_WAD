<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobSequenceApp</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobSequenceApp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="app-sidebar" id="sidebar">
            <div class="app-sidebar-header">
                <span class="material-symbols-outlined me-2 text-primary">work</span>
                JobSequence
            </div>
            
            <nav class="app-sidebar-nav">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="sidebar-nav-item" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="material-symbols-outlined me-3">home</span> Home
                    </a>
                    <a class="sidebar-nav-item" asp-area="" asp-controller="Home" asp-action="Index" fragment="how-it-works">
                        <span class="material-symbols-outlined me-3">info</span> How It Works
                    </a>
                    <a class="sidebar-nav-item" asp-area="Identity" asp-page="/Account/Login">
                        <span class="material-symbols-outlined me-3">login</span> Login
                    </a>
                    <a class="sidebar-nav-item" asp-area="Identity" asp-page="/Account/Register">
                        <span class="material-symbols-outlined me-3">person_add</span> Register
                    </a>
                }
                
                @if (User.IsInRole("Admin"))
                {
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">dashboard</span> Dashboard
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <span class="material-symbols-outlined me-3">group</span> Users
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Workers" asp-action="Index">
                        <span class="material-symbols-outlined me-3">engineering</span> Workers
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                        <span class="material-symbols-outlined me-3">book_online</span> Bookings
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Jobs" asp-action="Index">
                        <span class="material-symbols-outlined me-3">work</span> Jobs
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Workers" asp-action="Index" asp-route-pendingOnly="true">
                        <span class="material-symbols-outlined me-3">verified</span> Verification
                    </a>
                    <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                        <span class="material-symbols-outlined me-3">bar_chart</span> Reports
                    </a>
                }
                else if (User.IsInRole("Customer"))
                {
                    <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">dashboard</span> Dashboard
                    </a>
                    <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Workers" asp-action="Index">
                        <span class="material-symbols-outlined me-3">search</span> Find Workers
                    </a>
                    <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Bookings" asp-action="Index">
                        <span class="material-symbols-outlined me-3">event_note</span> Bookings
                    </a>
                    <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">notifications</span> Notifications
                    </a>
                    <a class="sidebar-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <span class="material-symbols-outlined me-3">person</span> Profile
                    </a>
                }
                else if (User.IsInRole("Worker"))
                {
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">dashboard</span> Dashboard
                    </a>
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Jobs" asp-action="Index">
                        <span class="material-symbols-outlined me-3">work_history</span> Job Requests
                    </a>
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Schedule" asp-action="Index">
                        <span class="material-symbols-outlined me-3">list_alt</span> My Jobs
                    </a>
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Schedule" asp-action="Index">
                        <span class="material-symbols-outlined me-3">calendar_month</span> Schedule
                    </a>
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">notifications</span> Notifications
                    </a>
                    <a class="sidebar-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <span class="material-symbols-outlined me-3">person</span> Profile
                    </a>
                    <a class="sidebar-nav-item" asp-area="Worker" asp-controller="Dashboard" asp-action="Index">
                        <span class="material-symbols-outlined me-3">event_available</span> Availability
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            <!-- Header -->
            <header class="app-header">
                <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="header-right ms-auto">
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <!-- Content -->
            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
