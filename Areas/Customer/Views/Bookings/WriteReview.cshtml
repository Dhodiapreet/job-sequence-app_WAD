@model JobSequenceApp.Models.Review

@{
    ViewData["Title"] = "Write Review";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white p-4 text-center">
                <span class="material-symbols-outlined fs-1 mb-2">star_rate</span>
                <h4 class="mb-0">Rate your experience</h4>
                <p class="mb-0 text-white-50">Review for @ViewBag.WorkerName</p>
            </div>
            <div class="card-body p-5">
                <form asp-action="WriteReview" method="post">
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="WorkerProfileId" />
                    <input type="hidden" asp-for="CustomerProfileId" />

                    <div class="mb-4 text-center">
                        <label asp-for="Rating" class="form-label fw-bold d-block">Rating (1-5)</label>
                        <div class="rating-stars d-flex justify-content-center gap-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Rating" value="@i" id="rating@(i)" required>
                                    <label class="form-check-label" for="rating@(i)">@i <span class="material-symbols-outlined text-warning fs-6">star</span></label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label fw-bold">Review Comment</label>
                        <textarea asp-for="Comment" class="form-control bg-light border-0 p-3" rows="4" placeholder="Write your review here..."></textarea>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-3 fw-bold fs-5">Submit Review</button>
                        <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
