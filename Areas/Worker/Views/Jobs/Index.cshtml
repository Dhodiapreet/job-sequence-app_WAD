@model IEnumerable<JobSequenceApp.Models.Booking>

@{
    ViewData["Title"] = "Job Requests";
}

<h2>Job Requests</h2>

<div class="row mt-4">
    @foreach (var request in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@request.Title</h5>
                    <span class="badge bg-light text-dark">REQUESTED</span>
                </div>
                <div class="card-body">
                    <p>
                        <strong>Customer:</strong> @request.CustomerProfile?.ApplicationUser?.FirstName @request.CustomerProfile?.ApplicationUser?.LastName<br />
                        <strong>Service:</strong> @request.Service<br />
                        <strong>Location:</strong> @request.Location<br />
                        <strong>Date:</strong> @request.ExpectedStartTime.ToShortDateString()<br />
                        <strong>Time:</strong> @request.ExpectedStartTime.ToShortTimeString() - @request.ExpectedEndTime.ToShortTimeString()
                    </p>
                    <p class="text-truncate">@request.Description</p>
                </div>
                <div class="card-footer bg-white d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline-primary w-100">View Details</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no pending job requests.</div>
}
