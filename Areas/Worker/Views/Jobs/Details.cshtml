@model JobSequenceApp.Models.Booking

@{
    ViewData["Title"] = "Job Request Details";
}

<h2>Job Request Details</h2>

<div class="card mt-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.Title</h5>
        <span class="badge bg-warning text-dark">@Model.Status</span>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6>Customer Details</h6>
                <p>
                    <strong>Name:</strong> @Model.CustomerProfile?.ApplicationUser?.FirstName @Model.CustomerProfile?.ApplicationUser?.LastName<br />
                    <strong>Location:</strong> @Model.Location
                </p>
            </div>
            <div class="col-md-6">
                <h6>Job Details</h6>
                <p>
                    <strong>Service:</strong> @Model.Service<br />
                    <strong>Date:</strong> @Model.ExpectedStartTime.ToShortDateString()<br />
                    <strong>Time:</strong> @Model.ExpectedStartTime.ToShortTimeString() - @Model.ExpectedEndTime.ToShortTimeString()
                </p>
            </div>
        </div>
        <hr />
        <h6>Description</h6>
        <p>@Model.Description</p>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <form asp-action="Accept" asp-route-id="@Model.Id" method="post" class="d-inline w-50">
            <button type="submit" class="btn btn-success w-100">Accept Job</button>
        </form>
        <form asp-action="Decline" asp-route-id="@Model.Id" method="post" class="d-inline w-50">
            <button type="submit" class="btn btn-danger w-100">Decline Job</button>
        </form>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Requests</a>
</div>
