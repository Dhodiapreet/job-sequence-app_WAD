@model IEnumerable<JobSequenceApp.Models.WorkerProfile>
@{
    var pendingOnly = ViewBag.PendingOnly is bool value && value;
}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="mb-1">@ViewData["Title"]</h2><p class="text-muted mb-0">Review worker profiles and manage verification status.</p></div>
        <div class="d-flex gap-2"><a asp-action="Index" asp-route-pendingOnly="false" class="btn btn-outline-secondary">All workers</a><a asp-action="Index" asp-route-pendingOnly="true" class="btn btn-outline-warning">Pending only</a></div>
    </div>
    @if (TempData["AdminMessage"] is string message) { <div class="alert alert-success alert-dismissible fade show" role="alert">@message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-3">Worker</th><th>Profession</th><th>Skills</th><th>Experience</th><th>Service area</th><th>Status</th><th class="text-end pe-3">Action</th></tr></thead><tbody>
        @foreach (var worker in Model)
        {
            <tr><td class="ps-3"><div class="fw-semibold">@worker.ApplicationUser?.FirstName @worker.ApplicationUser?.LastName</div><small class="text-muted">@worker.ApplicationUser?.Email</small></td><td>@worker.Profession</td><td>@(string.IsNullOrWhiteSpace(worker.Skills) ? "—" : worker.Skills)</td><td>@(string.IsNullOrWhiteSpace(worker.Experience) ? "—" : worker.Experience)</td><td>@(string.IsNullOrWhiteSpace(worker.ServiceArea) ? "—" : worker.ServiceArea)</td><td>@if (worker.IsVerified) { <span class="badge bg-success">Verified</span> } else { <span class="badge bg-warning text-dark">Pending</span> }</td><td class="text-end pe-3"><form asp-action="Verify" method="post" class="d-inline"><input type="hidden" name="id" value="@worker.Id" /><button type="submit" class="btn btn-sm @(worker.IsVerified ? "btn-outline-danger" : "btn-success")">@(worker.IsVerified ? "Revoke" : "Verify")</button></form></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">@(pendingOnly ? "There are no pending worker verifications." : "No workers registered yet.")</td></tr> }
        </tbody></table>
    </div></div></div>
</div>