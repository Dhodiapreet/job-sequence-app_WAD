@model IEnumerable<JobSequenceApp.Models.JobSequence>

@{
    ViewData["Title"] = "Job Monitoring";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><span class="material-symbols-outlined align-middle me-2 fs-2">construction</span>Job Monitoring</h2>
    
    <div class="btn-group">
        <a asp-action="Index" asp-route-status="" class="btn btn-outline-secondary @(Context.Request.Query["status"] == "" ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-status="Scheduled" class="btn btn-outline-primary @(Context.Request.Query["status"] == "Scheduled" ? "active" : "")">Scheduled</a>
        <a asp-action="Index" asp-route-status="InProgress" class="btn btn-outline-warning text-dark @(Context.Request.Query["status"] == "InProgress" ? "active" : "")">In Progress</a>
        <a asp-action="Index" asp-route-status="Completed" class="btn btn-outline-success @(Context.Request.Query["status"] == "Completed" ? "active" : "")">Completed</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4">Job ID</th>
                        <th>Worker</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Scheduled Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@job.Id</td>
                            <td>@job.WorkerProfile?.ApplicationUser?.FirstName @job.WorkerProfile?.ApplicationUser?.LastName</td>
                            <td>@job.Booking?.CustomerProfile?.ApplicationUser?.FirstName @job.Booking?.CustomerProfile?.ApplicationUser?.LastName</td>
                            <td>@job.Booking?.Service</td>
                            <td>
                                <div>@job.StartTime.ToShortDateString()</div>
                                <small class="text-muted">@job.StartTime.ToShortTimeString() - @job.EndTime.ToShortTimeString()</small>
                            </td>
                            <td>
                                @if(job.Status == "Completed")
                                {
                                    <span class="badge bg-success px-2 py-1">@job.Status.ToUpper()</span>
                                }
                                else if(job.Status == "InProgress")
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">IN_PROGRESS</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary px-2 py-1">@job.Status.ToUpper()</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No jobs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
