@model JobSequenceApp.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row">
        <!-- Overview Cards -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <h2 class="display-4">@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <h5 class="card-title">Customers</h5>
                    <h2 class="display-4">@Model.TotalCustomers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <h5 class="card-title">Total Workers</h5>
                    <h2 class="display-4">@Model.TotalWorkers</h2>
                    <p class="mb-0">Active: @Model.ActiveWorkers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">Pending Verifications</h5>
                    <h2 class="display-4">@Model.PendingWorkerVerifications</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">Booking Statistics</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Total Bookings
                            <span class="badge bg-primary rounded-pill">@Model.TotalBookings</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Active Bookings
                            <span class="badge bg-info rounded-pill">@Model.ActiveBookings</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Completed Bookings
                            <span class="badge bg-success rounded-pill">@Model.CompletedBookings</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Cancelled Bookings
                            <span class="badge bg-danger rounded-pill">@Model.CancelledBookings</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center fw-bold">
                            Active Jobs
                            <span class="badge bg-warning text-dark rounded-pill">@Model.ActiveJobs</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">Quick Actions</div>
                <div class="card-body d-flex flex-column justify-content-around">
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-success w-100 mb-2">View All Bookings</a>
                    <a asp-area="Admin" asp-controller="Jobs" asp-action="Index" class="btn btn-outline-warning w-100 mb-2">Monitor Jobs</a>
                    <a asp-area="Admin" asp-controller="Workers" asp-action="Index" class="btn btn-outline-info w-100 mb-2">Manage Workers</a>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-primary w-100 mb-2">Manage Users</a>
                    <a asp-area="Admin" asp-controller="Workers" asp-action="Index" asp-route-pendingOnly="true" class="btn btn-outline-secondary w-100 mb-2">Review Verifications</a>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-dark w-100">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>
